# Gateway Deployment Secrets
# Copy this file to .env.deployment and fill in your values, then run ./sync-secrets.sh

# AWS Credentials for CI/CD deployment
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# ECR & EC2 Identifiers
ECR_GATEWAY_REPO=inovo-gateway
GATEWAY_INSTANCE_NAME=inovo-gateway
GATEWAY_PORT=4000

# Gateway Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# Backend Private IP & Redis (fill in backend_private_ip from terraform output)
UPSTREAM_URL=http://<BACKEND_PRIVATE_IP>:8000
UPSTREAM_API_PREFIX=/api/v1
REDIS_URL=redis://<BACKEND_PRIVATE_IP>:6379/0

# Security Keys (INTERNAL_API_KEY must match backend's key)
INTERNAL_API_KEY=inovo-internal-service-token-2026
GATEWAY_SECRET=inovo-gateway-secret-token-2026-production

# ALB DNS and Allowed Hosts (from terraform output alb_dns_name)
APP_URL=http://<ALB_DNS_NAME>
ALLOWED_HOSTS=<ALB_DNS_NAME>,localhost
COOKIE_SECURE=false
TRUST_PROXY=true

# Storage driver
STORAGE_DRIVER=s3
S3_BUCKET=prod-inovo-bucket
S3_REGION=us-east-1

# Email / SMTP Configuration (for sending OTP codes and notifications)
SMTP_PROVIDER=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
MAIL_FROM=Invento <your_email@gmail.com>
